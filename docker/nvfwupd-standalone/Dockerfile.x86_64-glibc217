# Build a standalone x86_64 nvfwupd binary with a glibc 2.17 baseline.
#
# The direct host Cargo build inherits the host sysroot. On newer hosts that can
# produce binaries requiring newer glibc symbols than the Python nvfwupd artifact
# required.
#
# manylinux2014 is based on CentOS 7 and glibc 2.17, which matches the observed
# GLIBC symbol floor of the existing Python nvfwupd_arm64 binary and gives both
# standalone Rust NVFWUPD release artifacts the same compatibility baseline.
FROM quay.io/pypa/manylinux2014_x86_64:latest@sha256:0d25b049964b2549b83384036abdff06789a8c0b1e9ff003ec80f0d531f79e50 AS builder

ARG RUST_VERSION=1.96.0
ARG RUSTUP_VERSION=1.28.2
ARG RUSTUP_INIT_SHA256=20a06e644b0d9bd2fbdbfd52d42540bdde820ea7df86e92e533c073da0cdd43c
ENV CARGO_HOME=/opt/rust/cargo
ENV RUSTUP_HOME=/opt/rust/rustup
ENV PATH=/opt/rust/cargo/bin:${PATH}

RUN curl --proto '=https' --tlsv1.2 -fsSL -o /tmp/rustup-init \
        "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/x86_64-unknown-linux-gnu/rustup-init" \
    && echo "${RUSTUP_INIT_SHA256}  /tmp/rustup-init" | sha256sum -c - \
    && chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y --profile minimal --default-toolchain "${RUST_VERSION}" \
    && rm /tmp/rustup-init \
    && rustc --version \
    && cargo --version

WORKDIR /app

COPY . .

# The repository prefers lld for developer builds, but this compatibility
# builder intentionally uses the manylinux2014 toolchain default linker.
RUN sed -i '/fuse-ld=lld/d' .cargo/config.toml \
    && cargo build --locked --release -p nvfwupd \
    && install -Dm755 target/release/nvfwupd /out/nvfwupd

FROM scratch AS artifact
COPY --from=builder /out/nvfwupd /nvfwupd
