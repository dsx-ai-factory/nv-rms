# Ignore generated Helm package files
helm/*.tgz

# Local-only Python gRPC client (hand-run dev tooling, not part of the build).
# Kept on disk, deliberately untracked: it carries its own copies of the protos,
# which drift from the real ones in nv-rms-client the moment either changes.
scripts/python-client/

# NVSSVT release bundles for docker/nvssvt/Dockerfile. Too large for git;
# see docker/nvssvt/libs/README.md.
docker/nvssvt/libs/*
!docker/nvssvt/libs/README.md

vendor/

# Python bytecode from ci/ tooling.
__pycache__/
