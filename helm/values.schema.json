{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "databaseMode": {
      "type": "string",
      "enum": ["external", "standalone", "memory", "forge"],
      "description": "external: existing PostgreSQL cluster. standalone: chart-managed Postgres. memory: in-memory only (dev/testing, data lost on restart). forge is a deprecated alias for external."
    },
    "global": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "tag": {
              "type": "string",
              "description": "RMS API server image tag. Independent of Chart.yaml version."
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "imagePullSecrets": {
          "type": "array"
        }
      }
    },
    "apiServer": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": {
              "type": "string",
              "enum": ["", "Always", "IfNotPresent", "Never"],
              "description": "Empty string inherits global.image.pullPolicy."
            }
          }
        },
        "firmwarePersistentVolumeClaim": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$",
          "description": "Existing PVC claimName for the firmware download filesystem. Empty string uses apiServer.firmwareStoragePath hostPath. Non-empty values must be valid Kubernetes DNS subdomain names."
        }
      }
    }
  }
}
